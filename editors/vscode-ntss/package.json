{
  "name": "natyv-ntss",
  "displayName": "natyv Stylesheet (.ntss)",
  "description": "Syntax highlighting for natyv's .ntss stylesheet files.",
  "version": "0.1.0",
  "publisher": "natyv",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ntss",
        "aliases": ["natyv Stylesheet", "ntss"],
        "extensions": [".ntss"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ntss",
        "scopeName": "source.ntss",
        "path": "./syntaxes/ntss.tmLanguage.json"
      }
    ]
  }
}
