<idea-plugin>
    <id>dev.natyv.ntss</id>
    <name>natyv Stylesheet</name>
    <vendor>natyv</vendor>
    <description>Syntax highlighting for natyv's .ntss stylesheet files.</description>
    <version>0.1.0</version>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="ntss"
                  implementationClass="dev.natyv.ntss.NtssFileType"
                  fieldName="INSTANCE"
                  language="ntss"
                  extensions="ntss"/>
        <lang.syntaxHighlighterFactory language="ntss"
                  implementationClass="dev.natyv.ntss.NtssSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="dev.natyv.ntss.NtssColorSettingsPage"/>
    </extensions>
</idea-plugin>
