{
  "name": "natyv-ntx",
  "displayName": "natyv .ntx Language Support",
  "description": "Real-time diagnostics, hover, and go-to-definition for natyv's .ntx markup files via the ntx-lsp language server. Stage 1 (~/.claude/plans/lexical-wishing-penguin.md): lifecycle handshake only -- no diagnostics/hover/go-to-definition are wired up server-side yet.",
  "version": "0.1.0",
  "publisher": "natyv",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ntx"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ntx",
        "aliases": ["natyv Markup", "ntx"],
        "extensions": [".ntx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "natyv .ntx",
      "properties": {
        "ntx.serverPath": {
          "type": "string",
          "default": "ntx-lsp",
          "description": "Path to the ntx-lsp binary. Defaults to relying on PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
